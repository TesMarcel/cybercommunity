# Copier ce fichier en .env puis remplir les valeurs

PORT=5000

# postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/cyber_community

# Secret de signature des tokens (obligatoire)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Base dédiée aux tests (npm test). Elle est VIDÉE à chaque lancement :
# son nom doit obligatoirement se terminer par _test
TEST_DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/cyber_community_test

# Facultatif : limites anti brute-force (par IP)
# LOGIN_RATE_LIMIT=10       échecs de connexion par 15 minutes
# REGISTER_RATE_LIMIT=5     comptes créés par heure
